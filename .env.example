# ---------------------------------------------------------------------------
# BADGER environment variables
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL -----------------------------------------------------------------
# The Prisma schema reads POSTGRES_PRISMA_URL (pooled, used at runtime) and
# POSTGRES_URL_NON_POOLING (direct, used by migrations). These are the exact
# names the Vercel/Neon integration injects automatically in production — so on
# Vercel you don't set these by hand. Locally, point both at your own Postgres.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth mode ------------------------------------------------------------------
# "local" = built-in username/password auth with cookie sessions (no external
#           service; great for local dev). "clerk" = Clerk-hosted auth.
NEXT_PUBLIC_AUTH_MODE="clerk"

# Clerk authentication (used when NEXT_PUBLIC_AUTH_MODE=clerk) ----------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="<your-clerk-publishable-key>"
CLERK_SECRET_KEY="<your-clerk-secret-key>"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"
# Signing secret for the Clerk -> /api/webhooks/clerk user sync webhook.
CLERK_WEBHOOK_SECRET="<your-clerk-webhook-signing-secret>"

# AI provider ----------------------------------------------------------------
# Provider-agnostic. Currently supported: "openai". Leave key empty to use the
# built-in deterministic fallback parser (no external calls, dev-friendly).
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional: point at an OpenAI-compatible endpoint (Azure, local, etc.)
OPENAI_BASE_URL=""

# App ------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"

# Notifications --------------------------------------------------------------
# Email reminders via Brevo (free 300/day; verify a single sender — no domain needed).
BREVO_API_KEY=""
EMAIL_FROM="you@example.com"
EMAIL_FROM_NAME="Badger"

# Web Push (VAPID). Generate a pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Secret protecting the /api/cron/reminders endpoint. Vercel Cron sends it as a Bearer token.
CRON_SECRET=""
